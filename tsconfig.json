{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2024"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": [
			"node"
		]
	},
	"include": [
		"index.ts",
		"tests/**/*.ts"
	]
}
